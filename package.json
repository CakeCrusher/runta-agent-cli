{
  "name": "altrunta",
  "version": "0.1.3",
  "description": "Agent-native CLI for the Runta API, generated at run time from its OpenAPI spec (unofficial). Installs the `runta` and `altrunta` commands.",
  "type": "module",
  "bin": {
    "runta": "bin/runta.js",
    "altrunta": "bin/runta.js"
  },
  "files": [
    "bin/",
    "dist/",
    "spec/*.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "build:spec": "node scripts/build-spec.mjs",
    "test": "npm run build && node --test test/*.test.js",
    "contract": "npm run build && node scripts/contract-test.mjs",
    "prepublishOnly": "npm test",
    "check:dist": "npm run build && git diff --exit-code -- dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CakeCrusher/runta-agent-cli.git"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "yaml": "^2.6.0"
  },
  "keywords": [
    "runta",
    "cli",
    "agents",
    "openapi",
    "cloud-agents"
  ],
  "homepage": "https://github.com/CakeCrusher/runta-agent-cli#readme"
}
